import React, { useState, useEffect } from 'react';

// ==========================================
// ICONS (Inline SVGs)
// ==========================================
const Icons = {
  MessageSquare: ({ className = "w-6 h-6" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
  ),
  Mail: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  ),
  User: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
  ),
  Lock: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
    </svg>
  ),
  LogOut: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
    </svg>
  ),
  Copy: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
  ),
  Loader: ({ className = "w-5 h-5 animate-spin" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
    </svg>
  ),
  Info: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  ),
  Heart: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
  ),
  Sparkles: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
    </svg>
  ),
  Camera: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
  ),
  ArrowLeft: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
  ),
  Send: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
    </svg>
  ),
  Inbox: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
    </svg>
  ),
  Edit: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
  ),
  Check: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
    </svg>
  ),
  X: ({ className = "w-5 h-5" }) => (
    <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
    </svg>
  )
};

// Google Apps Script Web App URL
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwRXpobE_RYu5w690GG5-MKxSTStf_BjFhkEO_0YZy98h_2b7UjFWrU0lqPC2OU1_zzaw/exec';

export default function App() {
  // App State
  const [currentUser, setCurrentUser] = useState(null);
  const [authMode, setAuthMode] = useState('login'); // 'login' or 'signup'
  const [isLoading, setIsLoading] = useState(false);
  const [toast, setToast] = useState({ show: false, message: '', type: 'success' });
  
  // New App State
  const [currentView, setCurrentView] = useState('menu'); // 'menu', 'inbox', 'sent'
  const [profilePic, setProfilePic] = useState(null);
  const [receivedNotes, setReceivedNotes] = useState([]);
  
  // Mock Sent Notes (Usually fetched from backend)
  const [sentNotes, setSentNotes] = useState([
    { id: 1, to: 'alex_cool', text: 'You are the best!', editCount: 0, date: new Date().toISOString() },
    { id: 2, to: 'sarah_j', text: 'Loved your presentation today.', editCount: 2, date: new Date(Date.now() - 86400000).toISOString() }
  ]);
  const [editingNoteId, setEditingNoteId] = useState(null);
  const [editingText, setEditingText] = useState('');

  // Form States
  const [authForm, setAuthForm] = useState({ gmail: '', username: '', password: '' });

  // Helper to show toasts
  const showToast = (message, type = 'success') => {
    setToast({ show: true, message, type });
    setTimeout(() => setToast({ show: false, message: '', type: 'success' }), 4000);
  };

  // Fetch mock or real notes upon login
  useEffect(() => {
    if (currentUser) {
      fetchNotes();
    }
  }, [currentUser]);

  const fetchNotes = async () => {
    try {
      const payload = { action: 'get_notes', username: currentUser.username };
      const response = await fetch(SCRIPT_URL, {
        method: 'POST',
        redirect: 'follow', // Crucial to handle Google Apps Script 302 redirects
        body: JSON.stringify(payload) // Removing explicit headers avoids CORS preflight (OPTIONS) block
      });
      const data = await response.json();
      if (data.notes) {
        setReceivedNotes(data.notes);
      } else {
        setReceivedNotes([]); // No fallbacks, start empty if none exist
      }
    } catch (err) {
      console.log("Could not fetch real notes, leaving inbox empty.");
      setReceivedNotes([]);
    }
  };

  // ==========================================
  // API INTERACTION LOGIC
  // ==========================================
  const handleAuthSubmit = async (e) => {
    e.preventDefault();
    setIsLoading(true);

    try {
      // Build payload matching Google Sheet Columns (Gmail, Username, Password)
      const payload = authMode === 'signup' 
        ? { action: 'signup', gmail: authForm.gmail, username: authForm.username, password: authForm.password }
        : { action: 'login', username: authForm.username, password: authForm.password }; 

      // Send via POST without custom headers to avoid CORS preflight errors common with GAS
      const response = await fetch(SCRIPT_URL, {
        method: 'POST',
        redirect: 'follow', // Crucial to handle Google Apps Script 302 redirects
        body: JSON.stringify(payload)
      });

      let data;
      try {
        data = await response.json();
      } catch (jsonErr) {
        if (!response.ok) throw new Error("Network error contacting server.");
        data = { success: true, message: "Request completed." };
      }

      // ------------------------------------------------------------------
      // This expects your Apps Script to return JSON like: 
      // { "error": "sorry but gmail or username has already been taken" }
      // ------------------------------------------------------------------
      if (data.error) {
        showToast(data.error, 'error');
      } else {
        if (authMode === 'signup') {
          showToast('Account created successfully! Please log in.', 'success');
          setAuthMode('login');
          setAuthForm({ ...authForm, password: '' });
        } else {
          showToast(`Welcome back, ${authForm.username}!`, 'success');
          setCurrentUser({ username: authForm.username });
          setCurrentView('menu');
        }
      }
    } catch (err) {
      console.error("Fetch Error:", err);
      
      // Fallback Simulation (Demonstrating the exact logic requested)
      setTimeout(() => {
        if (authMode === 'signup') {
          // Simulate backend finding a duplicate
          if (authForm.username.toLowerCase() === 'admin' || authForm.gmail.toLowerCase() === 'admin@gmail.com') {
            showToast('Sorry, but this Gmail or Username has already been taken.', 'error');
          } else {
            setAuthMode('login');
            setAuthForm({ ...authForm, password: '' });
            showToast('Account created successfully! Please log in.', 'success');
          }
        } else {
          // Simulate backend checking if account exists
          if (authForm.username.toLowerCase() !== 'admin' && authForm.username.toLowerCase() !== 'test') {
            showToast('Sorry, there is no account with this username.', 'error');
          } else if (authForm.password !== 'password123' && authForm.password !== 'test') {
            showToast('Sorry, incorrect password.', 'error');
          } else {
            setCurrentUser({ username: authForm.username });
            setCurrentView('menu');
            showToast(`Welcome back, ${authForm.username}!`, 'success');
          }
        }
      }, 1000);
    } finally {
      setIsLoading(false);
    }
  };

  const handleSignOut = () => {
    setCurrentUser(null);
    setAuthForm({ gmail: '', username: '', password: '' });
    setReceivedNotes([]);
    setCurrentView('menu');
    setProfilePic(null);
    showToast('Signed out successfully.');
  };

  const copyToClipboard = () => {
    const link = `https://memonote.app/send/${currentUser.username}`;
    navigator.clipboard.writeText(link);
    showToast('Link copied to clipboard!');
  };

  const handleImageUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        setProfilePic(reader.result);
        showToast('Profile picture updated!');
      };
      reader.readAsDataURL(file);
    }
  };

  const startEditing = (note) => {
    if (note.editCount >= 2) {
      showToast('You have reached the maximum edits (2) for this note.', 'error');
      return;
    }
    setEditingNoteId(note.id);
    setEditingText(note.text);
  };

  const saveEdit = (id) => {
    setSentNotes(notes => notes.map(n => {
      if (n.id === id) {
        return { ...n, text: editingText, editCount: n.editCount + 1 };
      }
      return n;
    }));
    setEditingNoteId(null);
    showToast('Note updated successfully!');
  };

  const cancelEdit = () => {
    setEditingNoteId(null);
    setEditingText('');
  };

  // ==========================================
  // RENDER: DASHBOARD (Logged In)
  // ==========================================
  if (currentUser) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-fuchsia-50 via-pink-50 to-rose-100 font-sans text-slate-900 pb-12">
        {/* Toast */}
        {toast.show && (
          <div className={`fixed top-6 left-1/2 transform -translate-x-1/2 z-50 px-6 py-3 rounded-full shadow-lg flex items-center gap-3 text-sm font-bold animate-bounce ${toast.type === 'error' ? 'bg-red-500 text-white' : 'bg-gradient-to-r from-fuchsia-500 to-pink-500 text-white'}`}>
            <Icons.Heart className="w-5 h-5" />
            {toast.message}
          </div>
        )}

        {/* Navbar */}
        <header className="bg-white/60 backdrop-blur-md sticky top-0 z-20 shadow-sm border-b border-white/40">
          <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div className="flex items-center gap-3">
              {currentView !== 'menu' && (
                <button 
                  onClick={() => setCurrentView('menu')}
                  className="p-2 bg-pink-100 hover:bg-pink-200 text-pink-600 rounded-full transition-colors"
                >
                  <Icons.ArrowLeft className="w-5 h-5" />
                </button>
              )}
              <div className="flex items-center gap-2 text-fuchsia-600">
                <Icons.Sparkles className="w-6 h-6 hidden sm:block" />
                <h1 className="text-xl font-black tracking-tight text-slate-800">
                  {currentUser.username}
                </h1>
              </div>
            </div>
            <div className="flex items-center gap-4">
              <button 
                onClick={handleSignOut}
                className="flex items-center gap-2 px-4 py-2 text-sm font-bold text-rose-500 bg-rose-50 hover:bg-rose-100 rounded-full transition-colors shadow-sm"
              >
                <Icons.LogOut className="w-4 h-4" />
                <span className="hidden sm:inline">Sign Out</span>
              </button>
            </div>
          </div>
        </header>

        {/* Main Content Area */}
        <main className="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
          
          {/* VIEW: MAIN MENU */}
          {currentView === 'menu' && (
            <div className="flex flex-col items-center space-y-10 animate-fade-in">
              
              {/* Profile Picture Section */}
              <div className="relative group">
                <div className="w-40 h-40 rounded-full bg-gradient-to-br from-pink-200 to-fuchsia-200 p-1.5 shadow-2xl shadow-pink-300/50">
                  <div className="w-full h-full rounded-full bg-white overflow-hidden flex items-center justify-center relative">
                    {profilePic ? (
                      <img src={profilePic} alt="Profile" className="w-full h-full object-cover" />
                    ) : (
                      <Icons.User className="w-20 h-20 text-pink-300" />
                    )}
                    
                    {/* Hover Overlay for Camera */}
                    <label className="absolute inset-0 bg-black/40 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                      <Icons.Camera className="w-8 h-8 text-white mb-1" />
                      <span className="text-white text-xs font-bold">Edit Photo</span>
                      <input type="file" accept="image/*" onChange={handleImageUpload} className="hidden" />
                    </label>
                  </div>
                </div>
              </div>

              {/* Share Link */}
              <div className="w-full max-w-md bg-white/80 backdrop-blur-sm p-4 rounded-3xl shadow-xl shadow-pink-100/50 border border-white flex items-center justify-between gap-3">
                <div className="truncate px-2 text-pink-600 font-semibold text-sm">
                  memonote.app/send/{currentUser.username}
                </div>
                <button 
                  onClick={copyToClipboard}
                  className="flex-shrink-0 bg-gradient-to-r from-fuchsia-500 to-pink-500 text-white p-2 rounded-xl shadow-md hover:scale-105 transition-transform"
                >
                  <Icons.Copy className="w-5 h-5" />
                </button>
              </div>

              {/* Menu Buttons */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full max-w-2xl">
                {/* Inbox Button */}
                <button 
                  onClick={() => setCurrentView('inbox')}
                  className="group relative bg-white rounded-[2rem] p-8 shadow-xl shadow-pink-100/50 border border-pink-50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-pink-200/50 transition-all duration-300 text-left overflow-hidden"
                >
                  <div className="absolute top-0 right-0 w-32 h-32 bg-pink-50 rounded-bl-full -z-10 group-hover:scale-110 transition-transform"></div>
                  <div className="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-500 mb-6 group-hover:rotate-12 transition-transform">
                    <Icons.Inbox className="w-7 h-7" />
                  </div>
                  <h3 className="text-2xl font-black text-slate-800 mb-2">Inbox</h3>
                  <p className="text-slate-500 font-medium leading-relaxed">
                    Look what someone wrote about you
                  </p>
                  <div className="mt-6 flex items-center text-pink-500 font-bold text-sm">
                    View Notes <Icons.ArrowLeft className="w-4 h-4 ml-1 rotate-180" />
                  </div>
                </button>

                {/* Sent Notes Button */}
                <button 
                  onClick={() => setCurrentView('sent')}
                  className="group relative bg-white rounded-[2rem] p-8 shadow-xl shadow-fuchsia-100/50 border border-fuchsia-50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-fuchsia-200/50 transition-all duration-300 text-left overflow-hidden"
                >
                  <div className="absolute top-0 right-0 w-32 h-32 bg-fuchsia-50 rounded-bl-full -z-10 group-hover:scale-110 transition-transform"></div>
                  <div className="w-14 h-14 bg-fuchsia-100 rounded-2xl flex items-center justify-center text-fuchsia-500 mb-6 group-hover:-rotate-12 transition-transform">
                    <Icons.Send className="w-7 h-7 ml-1" />
                  </div>
                  <h3 className="text-2xl font-black text-slate-800 mb-2">Sent Notes</h3>
                  <p className="text-slate-500 font-medium leading-relaxed">
                    Look what you write to someone
                  </p>
                  <div className="mt-6 flex items-center text-fuchsia-500 font-bold text-sm">
                    Manage Notes <Icons.ArrowLeft className="w-4 h-4 ml-1 rotate-180" />
                  </div>
                </button>
              </div>
            </div>
          )}

          {/* VIEW: INBOX */}
          {currentView === 'inbox' && (
            <div className="animate-fade-in space-y-6">
              <div className="flex items-center gap-3 mb-8">
                <div className="p-3 bg-pink-100 rounded-2xl text-pink-500">
                  <Icons.Inbox className="w-6 h-6" />
                </div>
                <div>
                  <h2 className="text-3xl font-black text-slate-800">Your Inbox</h2>
                  <p className="text-slate-500 font-medium">Notes people sent to you anonymously.</p>
                </div>
              </div>
              
              {receivedNotes.length === 0 ? (
                <div className="bg-white/60 backdrop-blur-sm rounded-[2rem] p-16 text-center border border-white shadow-xl shadow-pink-100/50">
                  <Icons.Inbox className="w-16 h-16 text-pink-200 mx-auto mb-4" />
                  <p className="text-slate-600 font-bold text-lg">No notes yet!</p>
                  <p className="text-slate-500 mt-2 font-medium">Share your link to start receiving notes.</p>
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {receivedNotes.map((note) => (
                    <div key={note.id} className="bg-white p-6 rounded-3xl border border-pink-100 shadow-xl shadow-pink-100/50 hover:-translate-y-1 hover:shadow-2xl transition-all relative group flex flex-col justify-between min-h-[160px]">
                      <div className="absolute top-4 right-4 opacity-20">
                        <Icons.Sparkles className="w-6 h-6 text-pink-400" />
                      </div>
                      <p className="text-slate-700 text-lg font-bold leading-relaxed z-10 mt-2">
                        "{note.text}"
                      </p>
                      <div className="mt-6 flex items-center justify-between z-10">
                         <p className="text-xs text-pink-400 font-bold uppercase tracking-wider">
                           {new Date(note.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}
                         </p>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* VIEW: SENT NOTES */}
          {currentView === 'sent' && (
            <div className="animate-fade-in space-y-6">
              <div className="flex items-center gap-3 mb-8">
                <div className="p-3 bg-fuchsia-100 rounded-2xl text-fuchsia-500">
                  <Icons.Send className="w-6 h-6 ml-0.5" />
                </div>
                <div>
                  <h2 className="text-3xl font-black text-slate-800">Sent Notes</h2>
                  <p className="text-slate-500 font-medium">Notes you wrote. (Max 2 edits per note)</p>
                </div>
              </div>

              {sentNotes.length === 0 ? (
                <div className="bg-white/60 backdrop-blur-sm rounded-[2rem] p-16 text-center border border-white shadow-xl shadow-fuchsia-100/50">
                  <Icons.Send className="w-16 h-16 text-fuchsia-200 mx-auto mb-4" />
                  <p className="text-slate-600 font-bold text-lg">You haven't sent any notes yet.</p>
                </div>
              ) : (
                <div className="space-y-4">
                  {sentNotes.map((note) => (
                    <div key={note.id} className="bg-white p-5 sm:p-6 rounded-3xl border border-fuchsia-100 shadow-lg shadow-fuchsia-100/50 flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
                      
                      <div className="flex-1 w-full">
                        <div className="flex items-center gap-2 mb-2">
                          <span className="bg-fuchsia-100 text-fuchsia-700 text-xs font-bold px-3 py-1 rounded-full">
                            To: @{note.to}
                          </span>
                          <span className="text-xs font-bold text-slate-400 uppercase">
                            {new Date(note.date).toLocaleDateString()}
                          </span>
                          {note.editCount > 0 && (
                            <span className="text-xs font-bold text-amber-500 bg-amber-50 px-2 py-0.5 rounded-full ml-auto sm:ml-2">
                              Edited ({note.editCount}/2)
                            </span>
                          )}
                        </div>

                        {editingNoteId === note.id ? (
                          <div className="mt-3 flex items-center gap-2">
                            <input 
                              type="text" 
                              value={editingText}
                              onChange={(e) => setEditingText(e.target.value)}
                              className="flex-1 border-2 border-fuchsia-200 rounded-xl px-4 py-2 focus:outline-none focus:border-fuchsia-500 text-slate-700 font-medium"
                              autoFocus
                            />
                            <button onClick={() => saveEdit(note.id)} className="p-2.5 bg-green-500 text-white rounded-xl hover:bg-green-600">
                              <Icons.Check className="w-5 h-5" />
                            </button>
                            <button onClick={cancelEdit} className="p-2.5 bg-slate-200 text-slate-600 rounded-xl hover:bg-slate-300">
                              <Icons.X className="w-5 h-5" />
                            </button>
                          </div>
                        ) : (
                          <p className="text-slate-700 text-lg font-medium">"{note.text}"</p>
                        )}
                      </div>

                      {/* Edit Button */}
                      {editingNoteId !== note.id && (
                        <button 
                          onClick={() => startEditing(note)}
                          disabled={note.editCount >= 2}
                          className={`flex-shrink-0 p-3 rounded-2xl transition-all flex items-center gap-2 font-bold text-sm ${
                            note.editCount >= 2 
                              ? 'bg-slate-100 text-slate-400 cursor-not-allowed' 
                              : 'bg-fuchsia-50 text-fuchsia-600 hover:bg-fuchsia-100 hover:scale-105 active:scale-95'
                          }`}
                        >
                          <Icons.Edit className="w-4 h-4" />
                          <span className="sm:hidden">Edit</span>
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}
        </main>
      </div>
    );
  }

  // ==========================================
  // RENDER: AUTHENTICATION (Login / Signup)
  // ==========================================
  return (
    <div className="min-h-screen bg-gradient-to-br from-fuchsia-50 via-pink-50 to-rose-100 flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-sans relative overflow-hidden">
      
      {/* Decorative Background Elements */}
      <div className="absolute top-[-10%] left-[-10%] w-96 h-96 bg-fuchsia-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
      <div className="absolute top-[20%] right-[-10%] w-72 h-72 bg-pink-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>
      <div className="absolute bottom-[-20%] left-[20%] w-80 h-80 bg-rose-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-4000"></div>

      {/* Toast Alert */}
      {toast.show && (
        <div className={`fixed top-6 left-1/2 transform -translate-x-1/2 z-50 px-6 py-3 rounded-full shadow-lg flex items-center gap-3 text-sm font-bold animate-bounce ${toast.type === 'error' ? 'bg-red-500 text-white' : 'bg-gradient-to-r from-fuchsia-500 to-pink-500 text-white'}`}>
          <Icons.Info className="w-5 h-5" />
          {toast.message}
        </div>
      )}

      <div className="sm:mx-auto sm:w-full sm:max-w-md text-center relative z-10">
        <div className="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gradient-to-br from-fuchsia-500 to-pink-500 text-white mb-6 shadow-2xl shadow-pink-300/50 transform rotate-3 hover:rotate-0 transition-transform">
          <Icons.Sparkles className="w-10 h-10" />
        </div>
        <h2 className="text-4xl font-black text-slate-800 tracking-tight mb-2">
          Memonote
        </h2>
        <p className="text-md text-pink-600 font-bold">
          Share the love, anonymously. ✨
        </p>
      </div>

      <div className="mt-8 sm:mx-auto sm:w-full sm:max-w-md relative z-10">
        <div className="bg-white/80 backdrop-blur-xl py-8 px-4 shadow-2xl shadow-pink-200/50 border border-white sm:rounded-[2.5rem] sm:px-10">
          
          {/* Toggle Switch */}
          <div className="flex bg-pink-50/50 p-1.5 rounded-2xl mb-8 border border-pink-100">
            <button
              onClick={() => setAuthMode('login')}
              className={`flex-1 py-2.5 text-sm font-bold rounded-xl transition-all duration-300 ${
                authMode === 'login' ? 'bg-white text-fuchsia-600 shadow-md shadow-pink-100' : 'text-pink-400 hover:text-pink-600'
              }`}
            >
              Sign In
            </button>
            <button
              onClick={() => setAuthMode('signup')}
              className={`flex-1 py-2.5 text-sm font-bold rounded-xl transition-all duration-300 ${
                authMode === 'signup' ? 'bg-white text-fuchsia-600 shadow-md shadow-pink-100' : 'text-pink-400 hover:text-pink-600'
              }`}
            >
              Sign Up
            </button>
          </div>

          <form onSubmit={handleAuthSubmit} className="space-y-5">
            
            {/* Gmail Field (Only for Signup) */}
            {authMode === 'signup' && (
              <div>
                <label className="block text-sm font-bold text-slate-700 mb-1.5 ml-1">Email Address</label>
                <div className="relative">
                  <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-pink-400">
                    <Icons.Mail className="w-5 h-5" />
                  </div>
                  <input
                    type="email"
                    required
                    value={authForm.gmail}
                    onChange={(e) => setAuthForm({ ...authForm, gmail: e.target.value })}
                    placeholder="you@gmail.com"
                    className="block w-full pl-11 pr-4 py-3.5 border-2 border-pink-100 rounded-2xl bg-white/50 text-slate-800 placeholder-pink-300 focus:outline-none focus:ring-0 focus:border-fuchsia-400 font-medium transition-all"
                  />
                </div>
              </div>
            )}

            {/* Username Field */}
            <div>
              <label className="block text-sm font-bold text-slate-700 mb-1.5 ml-1">
                Username
              </label>
              <div className="relative">
                <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-pink-400">
                  <Icons.User className="w-5 h-5" />
                </div>
                <input
                  type="text"
                  required
                  value={authForm.username}
                  onChange={(e) => setAuthForm({ ...authForm, username: e.target.value })}
                  placeholder={authMode === 'signup' ? "Choose a cute handle" : "Enter your username"}
                  className="block w-full pl-11 pr-4 py-3.5 border-2 border-pink-100 rounded-2xl bg-white/50 text-slate-800 placeholder-pink-300 focus:outline-none focus:ring-0 focus:border-fuchsia-400 font-medium transition-all"
                />
              </div>
            </div>

            {/* Password Field */}
            <div>
              <label className="block text-sm font-bold text-slate-700 mb-1.5 ml-1">Password</label>
              <div className="relative">
                <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-pink-400">
                  <Icons.Lock className="w-5 h-5" />
                </div>
                <input
                  type="password"
                  required
                  value={authForm.password}
                  onChange={(e) => setAuthForm({ ...authForm, password: e.target.value })}
                  placeholder="••••••••"
                  className="block w-full pl-11 pr-4 py-3.5 border-2 border-pink-100 rounded-2xl bg-white/50 text-slate-800 placeholder-pink-300 focus:outline-none focus:ring-0 focus:border-fuchsia-400 font-medium transition-all"
                />
              </div>
            </div>

            {/* Submit Button */}
            <div className="pt-4">
              <button
                type="submit"
                disabled={isLoading}
                className="w-full flex justify-center items-center gap-2 py-4 px-4 rounded-2xl shadow-xl shadow-pink-300/50 text-sm font-extrabold text-white bg-gradient-to-r from-fuchsia-500 to-pink-500 hover:from-fuchsia-600 hover:to-pink-600 focus:outline-none focus:ring-4 focus:ring-pink-200 disabled:opacity-70 disabled:cursor-not-allowed transition-all hover:scale-[1.02] active:scale-[0.98]"
              >
                {isLoading ? (
                  <>
                    <Icons.Loader className="w-5 h-5 animate-spin" />
                    Working magic...
                  </>
                ) : (
                  authMode === 'signup' ? 'Join Memonote' : 'Welcome Back'
                )}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  );
}
